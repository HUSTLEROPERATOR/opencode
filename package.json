{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode",
  "version": "1.0.0",
  "description": "AI-powered development tool",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm exec tsx packages/opencode/src/index.ts",
    "start": "pnpm exec tsx -r tsconfig-paths/register packages/opencode/src/index.ts",
    "typecheck": "pnpm -r run typecheck",
    "prepare": "husky install",
    "random": "echo 'Random script'"
  },
  "workspaces": [
    "packages/*",
    "packages/console/*",
    "packages/sdk/js",
    "packages/slack"
  ],
  "devDependencies": {
    "@tsconfig/bun": "*",
    "@types/node": "^22.13.0",
    "husky": "9.1.7",
    "prettier": "3.6.2",
    "sst": "3.17.19",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "turbo": "2.5.6",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "module-alias": "^2.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "_moduleAliases": {
    "@": "./packages/opencode/src"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sst/opencode"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 100
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "sharp",
    "tree-sitter",
    "tree-sitter-bash",
    "web-tree-sitter"
  ],
  "patchedDependencies": {
    "@solidjs/start@1.1.7": "patches/@solidjs%2Fstart@1.1.7.patch"
  },
  "overrides": {
    "@types/bun": "*",
    "@types/node": "*"
  }
}

{
  "name": "@opencode-ai/ui",
  "version": "1.0.25",
  "type": "module",
  "exports": {
    ".": "./src/components/index.ts",
    "./*": "./src/components/*.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./styles": "./src/styles/index.css",
    "./styles/tailwind": "./src/styles/tailwind/index.css",
    "./fonts/*": "./src/assets/fonts/*"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "dev": "vite",
    "generate:tailwind": "bun run script/tailwind.ts"
  },
  "devDependencies": {
    "@types/bun": "*",
    "@tsconfig/node22": "*",
    "typescript": "*",
    "vite": "*",
    "vite-plugin-solid": "*",
    "tailwindcss": "*",
    "@tailwindcss/vite": "*"
  },
  "dependencies": {
    "@kobalte/core": "*",
    "@opencode-ai/sdk": "workspace:*",
    "@pierre/precision-diffs": "*",
    "@shikijs/transformers": "3.9.2",
    "@solidjs/meta": "*",
    "@typescript/native-preview": "*",
    "fuzzysort": "*",
    "luxon": "*",
    "marked": "16.2.0",
    "marked-shiki": "1.2.1",
    "remeda": "*",
    "shiki": "3.9.2",
    "solid-js": "*",
    "solid-list": "*",
    "virtua": "*"
  }
}
